{
  "name": "bootleg",
  "version": "1.0.0",
  "description": "Find out where your photos are used online: a nightly Google Lens search of your own photo library, with every find checked against your original.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "index": "tsx src/cli.ts index",
    "scan": "tsx src/cli.ts scan",
    "nightly": "tsx src/cli.ts nightly",
    "status": "tsx src/cli.ts status",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exif-reader": "^2.0.3",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
